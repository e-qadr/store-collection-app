rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function operationalUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        profile().get('isActive', true) == true &&
        profile().get('mustChangePassword', false) == false;
    }

    function role() {
      return profile().get('role', '');
    }

    function adminUser() {
      return operationalUser() && role() == 'admin';
    }

    function accountantUser() {
      return operationalUser() && role() == 'accountant';
    }

    function catalogSupervisor() {
      return operationalUser() &&
        (role() == 'collector' || role() == 'accountant' || role() == 'admin');
    }

    function protectedPriceUser() {
      return catalogSupervisor();
    }

    function protectedPriceWriter() {
      return operationalUser() && role() == 'collector';
    }

    function branchBrandId() {
      let branchId = profile().get('branchId', '');
      return branchId is string && branchId.size() > 0 &&
        exists(/databases/$(database)/documents/branches/$(branchId))
        ? get(/databases/$(database)/documents/branches/$(branchId)).data.get('brand_id', '')
        : '';
    }

    function mayReadCatalogDocument(data) {
      return operationalUser() &&
        (catalogSupervisor() ||
          (branchBrandId().size() > 0 && data.brand_id == branchBrandId()));
    }

    function brandExists(brandId) {
      return brandId is string && brandId.size() > 0 &&
        exists(/databases/$(database)/documents/brands/$(brandId));
    }

    function validArchiveMetadata(data) {
      return data.active is bool &&
        (data.active == true
          ? !data.keys().hasAny([
              'archived_by',
              'archived_by_name',
              'archived_at'
            ])
          :
          (data.archived_by is string &&
            data.archived_by.size() > 0 &&
            data.archived_by_name is string &&
            data.archived_by_name.size() > 0 &&
            data.archived_at is timestamp));
    }

    function validCatalogUnit(unit) {
      return unit is map &&
        unit.keys().hasOnly([
          'unit_id',
          'display_value',
          'raw_value',
          'normalized_value'
        ]) &&
        unit.unit_id is string && unit.unit_id.size() > 0 &&
        unit.display_value is string && unit.display_value.size() > 0 &&
        unit.raw_value is string && unit.raw_value.size() > 0 &&
        (!unit.keys().hasAny(['normalized_value']) ||
          unit.normalized_value is string);
    }

    function validCatalogUnits(units) {
      let unitCount = units.size();
      return units is list && unitCount > 0 && unitCount <= 3 &&
        validCatalogUnit(units[0]) &&
        (unitCount < 2 || validCatalogUnit(units[1])) &&
        (unitCount < 3 || validCatalogUnit(units[2]));
    }

    function validSourceMetadata(metadata) {
      // This map deliberately has a closed schema: manager-readable product
      // documents cannot be used to smuggle a protected price in nested data.
      return metadata is map && metadata.keys().hasOnly([
        'source_profile',
        'source_file_sha256',
        'source_sheet',
        'source_row',
        'raw_material_value',
        'raw_group_value',
        'raw_primary_unit',
        'raw_unit_2',
        'raw_unit_3',
        'import_id',
        'original_group_missing',
        'fallback_system_group_assigned',
        'fallback_system_group_key',
        'fallback_system_group_id'
      ]) &&
        metadata.get('source_profile', '') is string &&
        metadata.get('source_file_sha256', '') is string &&
        metadata.get('source_sheet', '') is string &&
        metadata.get('source_row', 0) is int &&
        metadata.get('raw_material_value', '') is string &&
        metadata.get('raw_group_value', '') is string &&
        metadata.get('raw_primary_unit', '') is string &&
        metadata.get('raw_unit_2', '') is string &&
        metadata.get('raw_unit_3', '') is string &&
        metadata.get('import_id', '') is string &&
        metadata.get('original_group_missing', false) is bool &&
        metadata.get('fallback_system_group_assigned', false) is bool &&
        metadata.get('fallback_system_group_key', '') is string &&
        metadata.get('fallback_system_group_id', '') is string;
    }

    function uncategorizedGroupId(brandId) {
      return 'system-group-' + brandId + '-uncategorized';
    }

    function validFallbackSystemGroupMetadata(data) {
      let metadata = data.source_metadata;
      let fallbackAssigned = metadata.get(
        'fallback_system_group_assigned',
        false
      );
      let originalGroupMissing = metadata.get(
        'original_group_missing',
        false
      );
      return fallbackAssigned != originalGroupMissing
        ? false
        : fallbackAssigned == true
        ? (metadata.get('original_group_missing', false) == true &&
            metadata.fallback_system_group_key == 'uncategorized' &&
            metadata.fallback_system_group_id ==
              uncategorizedGroupId(data.brand_id))
        : !metadata.keys().hasAny([
            'fallback_system_group_key',
            'fallback_system_group_id'
          ]);
    }

    function validFallbackSystemGroupCreateAssignment(data) {
      return !data.keys().hasAny(['source_metadata']) ||
        data.source_metadata.get('fallback_system_group_assigned', false) != true ||
        data.group_id == data.source_metadata.fallback_system_group_id;
    }

    function validProductSourceProvenanceTransition() {
      return request.resource.data.get('source_metadata', {}) ==
        resource.data.get('source_metadata', {});
    }

    function validProductGroup(groupId, data) {
      return data.keys().hasOnly([
          'id',
          'brand_id',
          'name',
          'normalized_name',
          'legacy_code',
          'is_system_group',
          'system_key',
          'active',
          'created_by',
          'created_by_name',
          'created_at',
          'updated_by',
          'updated_by_name',
          'updated_at',
          'last_audit_event_id',
          'archived_by',
          'archived_by_name',
          'archived_at'
        ]) &&
        data.id == groupId &&
        brandExists(data.brand_id) &&
        data.name is string && data.name.size() > 0 &&
        data.normalized_name is string && data.normalized_name.size() > 0 &&
        data.is_system_group is bool &&
        validProductGroupIdentity(groupId, data) &&
        data.created_by is string && data.created_by.size() > 0 &&
        data.created_by_name is string &&
        data.created_at is timestamp &&
        data.updated_by is string && data.updated_by.size() > 0 &&
        data.updated_by_name is string &&
        data.updated_at is timestamp &&
        data.last_audit_event_id is string &&
        data.last_audit_event_id.size() > 0 &&
        (!data.keys().hasAny(['legacy_code']) || data.legacy_code is string) &&
        validArchiveMetadata(data);
    }

    function emptySystemKey(data) {
      return !data.keys().hasAny(['system_key']) ||
        data.system_key == null || data.system_key == '';
    }

    function validProductGroupIdentity(groupId, data) {
      return data.is_system_group == true
        ? (groupId == uncategorizedGroupId(data.brand_id) &&
            data.system_key == 'uncategorized' &&
            data.name == 'غير مصنف' &&
            data.normalized_name == 'غير مصنف' &&
            data.active == true &&
            !data.keys().hasAny(['legacy_code']))
        : (emptySystemKey(data) &&
            groupId != uncategorizedGroupId(data.brand_id) &&
            data.name != 'غير مصنف' &&
            data.normalized_name != 'غير مصنف' &&
            data.name != 'uncategorized' &&
            data.name != 'Uncategorized' &&
            data.name != 'UNCATEGORIZED' &&
            data.normalized_name != 'uncategorized' &&
            data.normalized_name != 'Uncategorized' &&
            data.normalized_name != 'UNCATEGORIZED' &&
            (!data.keys().hasAny(['legacy_code']) ||
              (data.legacy_code != 'uncategorized' &&
                data.legacy_code != 'Uncategorized' &&
                data.legacy_code != 'UNCATEGORIZED')));
    }

    function validProductSource(data) {
      return !data.keys().hasAny(['source_metadata']) ||
        (validSourceMetadata(data.source_metadata) &&
          validFallbackSystemGroupMetadata(data));
    }

    function validLegacyKeyPair(data) {
      return (!data.keys().hasAny(['legacy_code']) &&
          !data.keys().hasAny(['legacy_code_unique_key_id'])) ||
        (data.legacy_code is string && data.legacy_code.size() > 0 &&
          data.legacy_code_unique_key_id is string &&
          data.legacy_code_unique_key_id.size() > 0);
    }

    function productGroupMatches(data) {
      let group = getAfter(
        /databases/$(database)/documents/product_groups/$(data.group_id)
      ).data;
      return group.brand_id == data.brand_id &&
        (data.active == false || group.active == true);
    }

    function productUniqueKeyMatches(keyId, keyType, productId, data) {
      let uniqueKey = getAfter(
        /databases/$(database)/documents/product_unique_keys/$(keyId)
      ).data;
      return uniqueKey.brand_id == data.brand_id &&
        uniqueKey.key_type == keyType &&
        uniqueKey.product_id == productId;
    }

    function productKeysMatch(productId, data) {
      return productUniqueKeyMatches(
          data.name_unique_key_id,
          'name',
          productId,
          data
        ) &&
        (!data.keys().hasAny(['legacy_code_unique_key_id']) ||
          productUniqueKeyMatches(
            data.legacy_code_unique_key_id,
            'legacy_code',
            productId,
            data
          ));
    }

    function validProduct(productId, data) {
      return data.keys().hasOnly([
          'id',
          'brand_id',
          'group_id',
          'name',
          'normalized_name',
          'legacy_code',
          'units',
          'primary_unit_id',
          'active',
          'version',
          'name_unique_key_id',
          'legacy_code_unique_key_id',
          'source_metadata',
          'created_by',
          'created_by_name',
          'created_at',
          'updated_by',
          'updated_by_name',
          'updated_at',
          'last_audit_event_id',
          'archived_by',
          'archived_by_name',
          'archived_at'
        ]) &&
        data.id == productId &&
        brandExists(data.brand_id) &&
        data.group_id is string && data.group_id.size() > 0 &&
        data.name is string && data.name.size() > 0 &&
        data.normalized_name is string && data.normalized_name.size() > 0 &&
        validCatalogUnits(data.units) &&
        data.primary_unit_id is string && data.primary_unit_id.size() > 0 &&
        data.version is int && data.version > 0 &&
        data.name_unique_key_id is string && data.name_unique_key_id.size() > 0 &&
        data.created_by_name is string &&
        data.updated_by_name is string &&
        validLegacyKeyPair(data) &&
        validProductSource(data) &&
        validArchiveMetadata(data) &&
        productGroupMatches(data) &&
        productKeysMatch(productId, data);
    }

    function validUniqueKey(keyId, data) {
      return data.keys().hasOnly([
          'id',
          'brand_id',
          'key_type',
          'normalized_value',
          'product_id',
          'active',
          'created_by',
          'created_at',
          'updated_by',
          'updated_at'
        ]) &&
        data.id == keyId &&
        brandExists(data.brand_id) &&
        (data.key_type == 'name' || data.key_type == 'legacy_code') &&
        data.normalized_value is string && data.normalized_value.size() > 0 &&
        data.product_id is string && data.product_id.size() > 0 &&
        data.active is bool;
    }

    function uniqueKeyReferencesProduct(keyId, data) {
      let product = getAfter(
        /databases/$(database)/documents/products/$(data.product_id)
      ).data;
      return product.brand_id == data.brand_id &&
        product.active == data.active &&
        ((data.key_type == 'name' && product.name_unique_key_id == keyId) ||
          (data.key_type == 'legacy_code' &&
            product.legacy_code_unique_key_id == keyId));
    }

    function validAuditEvent(eventId, data) {
      return data.keys().hasOnly([
          'id',
          'entity_type',
          'entity_id',
          'brand_id',
          'action',
          'before',
          'after',
          'reason',
          'actor_uid',
          'actor_name',
          'actor_role',
          'created_at'
        ]) &&
        data.id == eventId &&
        (data.entity_type == 'product' ||
          data.entity_type == 'product_group' ||
          data.entity_type == 'product_accounting_profile') &&
        data.entity_id is string && data.entity_id.size() > 0 &&
        brandExists(data.brand_id) &&
        data.action is string && data.action.size() > 0 &&
        (!data.keys().hasAny(['before']) || data.before is map) &&
        (!data.keys().hasAny(['after']) || data.after is map) &&
        ((data.action == 'archived' || data.action == 'reactivated')
          ? (data.keys().hasAny(['reason']) &&
              data.reason is string && data.reason.size() > 0)
          : (!data.keys().hasAny(['reason']) || data.reason is string)) &&
        ((data.action == 'created' || data.action == 'system_group_created')
          ? (data.keys().hasAny(['after']) &&
              data.after is map && data.after.keys().size() > 0)
          : (data.keys().hasAll(['before', 'after']) &&
              data.before is map && data.before.keys().size() > 0 &&
              data.after is map && data.after.keys().size() > 0)) &&
        data.actor_uid == request.auth.uid &&
        data.actor_name is string &&
        data.actor_role == 'accountant' &&
        data.created_at == request.time;
    }

    function linkedAuditMatches(
      eventId,
      entityType,
      entityId,
      brandId,
      action
    ) {
      let audit = getAfter(
        /databases/$(database)/documents/product_audit_events/$(eventId)
      ).data;
      return audit.id == eventId &&
        audit.entity_type == entityType &&
        audit.entity_id == entityId &&
        audit.brand_id == brandId &&
        audit.action == action &&
        audit.actor_uid == request.auth.uid &&
        audit.actor_role == 'accountant' &&
        audit.created_at == request.time;
    }

    function productMutationAction() {
      return request.resource.data.active != resource.data.active
        ? (request.resource.data.active == true ? 'reactivated' : 'archived')
        : (request.resource.data.group_id != resource.data.group_id
            ? 'recategorized'
            : 'updated');
    }

    function validRecategorizationAuditSnapshot() {
      let auditId = request.resource.data.last_audit_event_id;
      let audit = getAfter(
        /databases/$(database)/documents/product_audit_events/$(auditId)
      ).data;
      return request.resource.data.group_id == resource.data.group_id ||
        (audit.before.get('group_id', '') == resource.data.group_id &&
          audit.after.get('group_id', '') == request.resource.data.group_id &&
          audit.before.get('version', 0) == resource.data.version &&
          audit.after.get('version', 0) == request.resource.data.version &&
          !audit.before.keys().hasAny(['source_metadata']) &&
          !audit.after.keys().hasAny(['source_metadata']));
    }

    function groupCreateAuditAction(data) {
      return data.is_system_group == true ? 'system_group_created' : 'created';
    }

    function validProductGroupIdentityTransition() {
      return resource.data.keys().hasAny(['is_system_group'])
        ? request.resource.data.is_system_group == resource.data.is_system_group
        : request.resource.data.is_system_group == false;
    }

    function validProductArchiveTransition() {
      let archiveFields = [
        'archived_by',
        'archived_by_name',
        'archived_at'
      ];
      return request.resource.data.active != resource.data.active
        ? (request.resource.data.active == false
            ? (request.resource.data.archived_by == request.auth.uid &&
                request.resource.data.archived_by_name is string &&
                request.resource.data.archived_by_name.size() > 0 &&
                request.resource.data.archived_at == request.time)
            : !request.resource.data.keys().hasAny(archiveFields))
        : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(archiveFields);
    }

    function productAuditTargetPointsBack(eventId, data) {
      let target = getAfter(
        /databases/$(database)/documents/products/$(data.entity_id)
      ).data;
      return target.last_audit_event_id == eventId &&
        target.brand_id == data.brand_id;
    }

    function groupAuditTargetPointsBack(eventId, data) {
      let target = getAfter(
        /databases/$(database)/documents/product_groups/$(data.entity_id)
      ).data;
      return target.last_audit_event_id == eventId &&
        target.brand_id == data.brand_id;
    }

    function accountingAuditTargetPointsBack(eventId, data) {
      let target = getAfter(
        /databases/$(database)/documents/product_accounting_profiles/$(data.entity_id)
      ).data;
      return target.last_audit_event_id == eventId &&
        target.brand_id == data.brand_id;
    }

    function auditTargetPointsBack(eventId, data) {
      return (data.entity_type == 'product' &&
          productAuditTargetPointsBack(eventId, data)) ||
        (data.entity_type == 'product_group' &&
          groupAuditTargetPointsBack(eventId, data)) ||
        (data.entity_type == 'product_accounting_profile' &&
          accountingAuditTargetPointsBack(eventId, data));
    }

    function validAccountingProfile(profileId, data) {
      return data.keys().hasOnly([
          'id',
          'product_id',
          'brand_id',
          'accounting_reference',
          'sync_state',
          'notes',
          'created_by',
          'created_at',
          'updated_by',
          'updated_at',
          'last_audit_event_id'
        ]) &&
        data.keys().hasAll([
          'id',
          'product_id',
          'brand_id',
          'sync_state',
          'created_by',
          'created_at',
          'updated_by',
          'updated_at',
          'last_audit_event_id'
        ]) &&
        data.id == profileId &&
        data.product_id == profileId &&
        brandExists(data.brand_id) &&
        getAfter(
          /databases/$(database)/documents/products/$(data.product_id)
        ).data.brand_id == data.brand_id &&
        data.sync_state is string && data.sync_state.size() > 0 &&
        (!data.keys().hasAny(['accounting_reference']) ||
          data.accounting_reference is string) &&
        (!data.keys().hasAny(['notes']) || data.notes is string) &&
        data.created_by is string && data.created_by.size() > 0 &&
        data.created_at is timestamp &&
        data.updated_by is string && data.updated_by.size() > 0 &&
        data.updated_at is timestamp &&
        data.last_audit_event_id is string &&
        data.last_audit_event_id.size() > 0;
    }

    function validCurrency(currency) {
      return currency == 'YER' || currency == 'SAR' || currency == 'USD';
    }

    function validPriceLatest(latestId, data) {
      return data.keys().hasOnly([
          'id',
          'latest_key',
          'history_event_id',
          'brand_id',
          'product_id',
          'unit_id',
          'unit_value',
          'currency',
          'price',
          'source_invoice_id',
          'changed_by',
          'changed_by_name',
          'changed_by_role',
          'changed_at',
          'version'
        ]) &&
        data.keys().hasAll([
          'id',
          'latest_key',
          'history_event_id',
          'brand_id',
          'product_id',
          'unit_id',
          'unit_value',
          'currency',
          'price',
          'source_invoice_id',
          'changed_by',
          'changed_by_name',
          'changed_by_role',
          'changed_at',
          'version'
        ]) &&
        data.id == latestId && data.latest_key == latestId &&
        brandExists(data.brand_id) &&
        data.product_id is string && data.product_id.size() > 0 &&
        priceProductUnitMatches(data) &&
        data.unit_id is string && data.unit_id.size() > 0 &&
        data.unit_value is string && data.unit_value.size() > 0 &&
        validCurrency(data.currency) &&
        data.price is number && data.price >= 0 &&
        data.source_invoice_id is string && data.source_invoice_id.size() > 0 &&
        data.changed_by == request.auth.uid &&
        data.changed_by_name is string &&
        data.changed_by_role == role() &&
        data.changed_at == request.time &&
        data.history_event_id is string && data.history_event_id.size() > 0 &&
        data.version is int && data.version > 0;
    }

    function priceUnitMatches(unit, unitId, unitValue) {
      return unit is map &&
        unit.unit_id == unitId && unit.display_value == unitValue;
    }

    function priceProductUnitMatches(data) {
      let product = getAfter(
        /databases/$(database)/documents/products/$(data.product_id)
      ).data;
      return product.brand_id == data.brand_id &&
        product.units is list && product.units.size() > 0 &&
        product.units.size() <= 3 &&
        (priceUnitMatches(product.units[0], data.unit_id, data.unit_value) ||
          (product.units.size() > 1 &&
            priceUnitMatches(product.units[1], data.unit_id, data.unit_value)) ||
          (product.units.size() > 2 &&
            priceUnitMatches(product.units[2], data.unit_id, data.unit_value)));
    }

    function latestMatchesHistory(latestId, data) {
      let history = getAfter(
        /databases/$(database)/documents/product_price_history/$(data.history_event_id)
      ).data;
      return history.id == data.history_event_id &&
        history.latest_key == latestId &&
        history.brand_id == data.brand_id &&
        history.product_id == data.product_id &&
        history.unit_id == data.unit_id &&
        history.unit_value == data.unit_value &&
        history.currency == data.currency &&
        history.price == data.price &&
        history.source_invoice_id == data.source_invoice_id &&
        history.changed_by == data.changed_by &&
        history.changed_by_role == data.changed_by_role &&
        history.changed_at == data.changed_at &&
        history.version == data.version;
    }

    function validPriceHistory(historyId, data) {
      return data.keys().hasOnly([
          'id',
          'latest_key',
          'brand_id',
          'product_id',
          'unit_id',
          'unit_value',
          'currency',
          'price',
          'previous_price',
          'previous_source_invoice_id',
          'source_invoice_id',
          'changed_by',
          'changed_by_name',
          'changed_by_role',
          'changed_at',
          'version'
        ]) &&
        data.keys().hasAll([
          'id',
          'latest_key',
          'brand_id',
          'product_id',
          'unit_id',
          'unit_value',
          'currency',
          'price',
          'source_invoice_id',
          'changed_by',
          'changed_by_name',
          'changed_by_role',
          'changed_at',
          'version'
        ]) &&
        data.id == historyId &&
        data.latest_key is string && data.latest_key.size() > 0 &&
        brandExists(data.brand_id) &&
        data.product_id is string && data.product_id.size() > 0 &&
        data.unit_id is string && data.unit_id.size() > 0 &&
        data.unit_value is string && data.unit_value.size() > 0 &&
        validCurrency(data.currency) &&
        data.price is number && data.price >= 0 &&
        (!data.keys().hasAny(['previous_price']) ||
          (data.previous_price is number && data.previous_price >= 0)) &&
        (!data.keys().hasAny(['previous_source_invoice_id']) ||
          data.previous_source_invoice_id is string) &&
        data.source_invoice_id is string && data.source_invoice_id.size() > 0 &&
        data.changed_by == request.auth.uid &&
        data.changed_by_name is string &&
        data.changed_by_role == role() &&
        data.changed_at == request.time &&
        data.version is int && data.version > 0 &&
        validPreviousPriceSnapshot(data);
    }

    function validPreviousPriceSnapshot(data) {
      let latestPath =
        /databases/$(database)/documents/product_price_latest/$(data.latest_key);
      return exists(latestPath)
        ? (data.keys().hasAll([
              'previous_price',
              'previous_source_invoice_id'
            ]) &&
            data.previous_price == get(latestPath).data.price &&
            data.previous_source_invoice_id ==
              get(latestPath).data.source_invoice_id)
        : !data.keys().hasAny([
            'previous_price',
            'previous_source_invoice_id'
          ]);
    }

    function historyMatchesLatest(historyId, data) {
      let latest = getAfter(
        /databases/$(database)/documents/product_price_latest/$(data.latest_key)
      ).data;
      return latest.history_event_id == historyId &&
        latest.brand_id == data.brand_id &&
        latest.product_id == data.product_id &&
        latest.unit_id == data.unit_id &&
        latest.unit_value == data.unit_value &&
        latest.currency == data.currency &&
        latest.price == data.price &&
        latest.source_invoice_id == data.source_invoice_id &&
        latest.changed_by == data.changed_by &&
        latest.changed_by_role == data.changed_by_role &&
        latest.changed_at == data.changed_at &&
        latest.version == data.version;
    }

    function knownInterBranchUser() {
      return operationalUser() &&
        (role() == 'manager' || role() == 'collector' ||
          role() == 'accountant' || role() == 'admin');
    }

    function interBranchSupervisor() {
      return knownInterBranchUser() &&
        (role() == 'collector' || role() == 'accountant' || role() == 'admin');
    }

    function actorBranchId() {
      return profile().get('branchId', '');
    }

    function workflowVersion(data) {
      return data.get('workflow_version', 1);
    }

    function normalizedLegacyInvoiceStatus(value) {
      return value == 'pendingSenderReview' ? 'requestPending' :
        value == 'approvedBySender' ? 'pendingReceiverReview' :
        value == 'rejectedBySender' ? 'requestRejectedBySupplier' :
        value == 'receivedByReceivingManager' ? 'pendingPriceEntry' :
        value == 'receivedByReceivingBranch' ? 'pendingPriceEntry' :
        value == 'pricesEnteredByCollector' ? 'pendingAccountingEntry' :
        value == 'pricedByGeneralManager' ? 'pendingAccountingEntry' :
        value == 'approvedByAccountant' ? 'postedToAccounting' :
        value;
    }

    function v2Status(value) {
      return value == 'pendingReceiverReview' ||
        value == 'pendingPriceEntry' ||
        value == 'pendingAccountingEntry' ||
        value == 'postedToAccounting';
    }

    function managerParticipates(data) {
      let branchId = actorBranchId();
      return role() == 'manager' &&
        branchId is string && branchId.size() > 0 &&
        data.branch_ids is list && data.branch_ids.hasAny([branchId]);
    }

    function mayReadInterBranchInvoice(invoiceId, data) {
      return knownInterBranchUser() &&
        ((workflowVersion(data) == 1 &&
            (interBranchSupervisor() || managerParticipates(data))) ||
          (workflowVersion(data) == 2 &&
            validV2PublicInvoice(invoiceId, data) &&
            (interBranchSupervisor() || managerParticipates(data))));
    }

    function validV2PublicItemData(invoiceId, item) {
      return item is map && item.keys().hasOnly([
        'id',
        'invoice_id',
        'schema_version',
        'workflow_version',
        'creation_mode',
        'invoice_revision',
        'branch_ids',
        'sending_branch_id',
        'receiving_branch_id',
        'line_number',
        'item_id',
        'product_id',
        'product_version',
        'product_brand_id',
        'product_name',
        'group_id',
        'group_name',
        'product_legacy_code',
        'group_legacy_code',
        'unit_id',
        'unit_value',
        'unit_raw_value',
        'supplied_quantity',
        'line_notes',
        'received_quantity',
        'damaged_quantity',
        'missing_quantity',
        'discrepancy_notes'
      ]) && item.keys().hasAll([
        'id',
        'invoice_id',
        'schema_version',
        'workflow_version',
        'creation_mode',
        'invoice_revision',
        'branch_ids',
        'sending_branch_id',
        'receiving_branch_id',
        'line_number',
        'item_id',
        'product_id',
        'product_version',
        'product_brand_id',
        'product_name',
        'group_id',
        'group_name',
        'unit_id',
        'unit_value',
        'unit_raw_value',
        'supplied_quantity'
      ]) &&
        item.id == item.item_id &&
        item.invoice_id == invoiceId &&
        item.schema_version == 2 && item.workflow_version == 2 &&
        item.creation_mode == 'direct_supplier_invoice' &&
        item.invoice_revision is int && item.invoice_revision > 0 &&
        item.branch_ids is list && item.branch_ids.size() == 2 &&
        item.branch_ids[0] == item.sending_branch_id &&
        item.branch_ids[1] == item.receiving_branch_id &&
        item.sending_branch_id != item.receiving_branch_id &&
        item.line_number is int && item.line_number > 0 &&
          item.line_number <= 50 &&
        item.product_id is string && item.product_id.size() > 0 &&
        item.product_version is int && item.product_version > 0 &&
        item.product_brand_id is string && item.product_brand_id.size() > 0 &&
        item.product_name is string && item.product_name.size() > 0 &&
        item.group_id is string && item.group_id.size() > 0 &&
        item.group_name is string && item.group_name.size() > 0 &&
        item.unit_id is string && item.unit_id.size() > 0 &&
        item.unit_value is string && item.unit_value.size() > 0 &&
        item.unit_raw_value is string && item.unit_raw_value.size() > 0 &&
        item.supplied_quantity is number && item.supplied_quantity > 0 &&
        (!item.keys().hasAny(['product_legacy_code']) ||
          item.product_legacy_code is string) &&
        (!item.keys().hasAny(['group_legacy_code']) ||
          item.group_legacy_code is string) &&
        (!item.keys().hasAny(['line_notes']) || item.line_notes is string) &&
        (!item.keys().hasAny(['discrepancy_notes']) ||
          item.discrepancy_notes is string) &&
        (!item.keys().hasAny(['received_quantity']) ||
          (item.received_quantity is number && item.received_quantity >= 0)) &&
        (!item.keys().hasAny(['damaged_quantity']) ||
          (item.damaged_quantity is number && item.damaged_quantity >= 0 &&
            item.keys().hasAny(['received_quantity']) &&
            item.damaged_quantity <= item.received_quantity)) &&
        (!item.keys().hasAny(['missing_quantity']) ||
          (item.missing_quantity is number && item.missing_quantity >= 0 &&
            item.keys().hasAny(['received_quantity'])));
    }

    function validV2PublicItem(invoiceId, itemId, item) {
      return validV2PublicItemData(invoiceId, item) && item.id == itemId;
    }

    function mayReadV2PublicItem(invoiceId, itemId, item) {
      return knownInterBranchUser() &&
        validV2PublicItem(invoiceId, itemId, item) &&
        (interBranchSupervisor() ||
          (role() == 'manager' &&
            item.branch_ids.hasAny([actorBranchId()])));
    }

    function mayListV2PublicItem(invoiceId, item) {
      // Firestore list authorization must be provable from queryable branch
      // metadata. The Admin SDK is the only writer and applies the same closed
      // schema used by strict single-document reads before every atomic write.
      return knownInterBranchUser() &&
        (interBranchSupervisor() ||
          (role() == 'manager' &&
            item.branch_ids.hasAny([actorBranchId()])));
    }

    function validV2PublicHistoryEvent(event) {
      return event is map &&
        event.keys().hasOnly([
          'action',
          'message',
          'actor_id',
          'actor_name',
          'actor_role',
          'timestamp'
        ]);
    }

    function validV2PublicHistory(events) {
      let eventCount = events.size();
      return events is list && eventCount > 0 && eventCount <= 4 &&
        (eventCount < 1 || validV2PublicHistoryEvent(events[0])) &&
        (eventCount < 2 || validV2PublicHistoryEvent(events[1])) &&
        (eventCount < 3 || validV2PublicHistoryEvent(events[2])) &&
        (eventCount < 4 || validV2PublicHistoryEvent(events[3]));
    }

    function validV2PublicInvoiceData(data) {
      return data is map &&
        data.keys().hasOnly([
          'id',
          'schema_version',
          'workflow_version',
          'creation_mode',
          'status',
          'revision',
          'invoice_number',
          'branch_code',
          'sending_branch_id',
          'sending_branch_name',
          'sending_brand_id',
          'receiving_branch_id',
          'receiving_branch_name',
          'receiving_brand_id',
          'branch_ids',
          'item_count',
          'item_digest',
          'invoice_notes',
          'receiver_notes',
          'receipt_confirmed_by',
          'receipt_confirmed_by_name',
          'receipt_confirmed_at',
          'accounting_reference',
          'posted_by',
          'posted_by_name',
          'posted_at',
          'created_by',
          'created_by_name',
          'created_by_role',
          'created_at',
          'last_updated',
          'history'
        ]) && data.keys().hasAll([
          'id',
          'schema_version',
          'workflow_version',
          'creation_mode',
          'status',
          'revision',
          'invoice_number',
          'branch_code',
          'sending_branch_id',
          'sending_branch_name',
          'sending_brand_id',
          'receiving_branch_id',
          'receiving_branch_name',
          'receiving_brand_id',
          'branch_ids',
          'item_count',
          'item_digest',
          'created_by',
          'created_by_name',
          'created_by_role',
          'created_at',
          'last_updated',
          'history'
        ]) &&
        data.id is string && data.id.size() > 0 &&
        data.schema_version == 2 &&
        data.workflow_version == 2 &&
        data.creation_mode == 'direct_supplier_invoice' &&
        v2Status(data.status) &&
        data.sending_branch_id != data.receiving_branch_id &&
        data.branch_ids is list && data.branch_ids.size() == 2 &&
        data.branch_ids[0] == data.sending_branch_id &&
        data.branch_ids[1] == data.receiving_branch_id &&
        data.revision is int && data.revision > 0 &&
        data.item_count is int && data.item_count > 0 &&
          data.item_count <= 50 &&
        data.item_digest is string && data.item_digest.size() == 64 &&
        validV2PublicHistory(data.history);
    }

    function validV2PublicInvoice(invoiceId, data) {
      return validV2PublicInvoiceData(data) && data.id == invoiceId;
    }

    function mayListInterBranchInvoice(data) {
      // Header lists retain the approved branch-scoped query contract. Strict
      // v2 identity/schema checks are applied to direct document reads, while
      // all v2 writes remain backend-only.
      return knownInterBranchUser() &&
        (interBranchSupervisor() ||
          (role() == 'manager' &&
            data.branch_ids.hasAny([actorBranchId()])));
    }

    function legacyInvoiceIdentityUnchanged() {
      return request.resource.data.get('id', '') == resource.data.get('id', '') &&
        request.resource.data.get('sending_branch_id', '') ==
          resource.data.get('sending_branch_id', '') &&
        request.resource.data.get('receiving_branch_id', '') ==
          resource.data.get('receiving_branch_id', '') &&
        request.resource.data.get('branch_ids', []) ==
          resource.data.get('branch_ids', []) &&
        request.resource.data.get('created_by', '') ==
          resource.data.get('created_by', '') &&
        request.resource.data.get('created_at', null) ==
          resource.data.get('created_at', null) &&
        request.resource.data.get('workflow_version', 1) == 1;
    }

    function legacyManagerFor(fieldName) {
      return role() == 'manager' &&
        actorBranchId() == resource.data.get(fieldName, '');
    }

    function legacyParticipantManager() {
      return role() == 'manager' &&
        resource.data.get('branch_ids', []).hasAny([actorBranchId()]);
    }

    function legacySharedStatus(status) {
      return status == 'cancellationPendingApprovals' ||
        status == 'editPendingApprovals';
    }

    function legacyCoreStatus(status) {
      return status == 'approvedBySupplier' ||
        status == 'invoiceCreated' ||
        status == 'pendingReceiverReview' ||
        status == 'receivedByReceivingManager' ||
        status == 'pendingPriceEntry' ||
        status == 'pricesEnteredByCollector' ||
        status == 'pendingAccountingEntry' ||
        status == 'postedToAccounting' ||
        status == 'editApproved' ||
        status == 'editRejected';
    }

    function legacyInvoiceTransitionAllowed() {
      let current = normalizedLegacyInvoiceStatus(
        resource.data.get('status', 'requestPending')
      );
      let next = normalizedLegacyInvoiceStatus(
        request.resource.data.get('status', '')
      );
      let managerParty = legacyParticipantManager();
      return (current == 'requestPending' &&
          legacyManagerFor('sending_branch_id') &&
          (next == 'requestRejectedBySupplier' ||
            next == 'pendingReceiverReview')) ||
        (current == 'pendingReceiverReview' &&
          legacyManagerFor('receiving_branch_id') &&
          next == 'pendingPriceEntry') ||
        (current == 'pendingPriceEntry' && role() == 'collector' &&
          next == 'pendingAccountingEntry') ||
        (current == 'pendingAccountingEntry' && role() == 'collector' &&
          next == 'pendingAccountingEntry') ||
        (current == 'pendingAccountingEntry' && role() == 'accountant' &&
          next == 'postedToAccounting') ||
        (legacyCoreStatus(current) &&
          next == 'editPendingApprovals' &&
          (managerParty || role() == 'collector' || role() == 'accountant')) ||
        (legacyCoreStatus(current) &&
          next == 'cancellationPendingApprovals' &&
          (managerParty || role() == 'accountant')) ||
        (legacySharedStatus(current) &&
          (managerParty || role() == 'accountant') &&
          (next == current || next == 'cancelled' ||
            next == 'editApproved' || next == 'editRejected' ||
            next == normalizedLegacyInvoiceStatus(
              resource.data.get('previous_status', '')
            )));
    }

    function legacyHistoryAppendOnly() {
      let beforeHistory = resource.data.get('history', []);
      let afterHistory = request.resource.data.get('history', []);
      return beforeHistory is list && afterHistory is list &&
        afterHistory.size() == beforeHistory.size() + 1 &&
        afterHistory.hasAll(beforeHistory);
    }

    function legacyInvoiceChangedKeysAllowed() {
      let current = normalizedLegacyInvoiceStatus(
        resource.data.get('status', 'requestPending')
      );
      let next = normalizedLegacyInvoiceStatus(
        request.resource.data.get('status', '')
      );
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (current == 'requestPending' &&
          next == 'requestRejectedBySupplier' &&
          changed.hasOnly([
            'status',
            'rejection_reason',
            'sender_notes',
            'last_updated',
            'history'
          ])) ||
        (current == 'requestPending' &&
          next == 'pendingReceiverReview' &&
          changed.hasOnly([
            'status',
            'invoice_number',
            'invoice_created_at',
            'approved_by',
            'approved_at',
            'approved_quantity',
            'items',
            'sender_notes',
            'last_updated',
            'history'
          ])) ||
        (current == 'pendingReceiverReview' &&
          next == 'pendingPriceEntry' &&
          changed.hasOnly([
            'status',
            'received_quantity',
            'items',
            'receiver_notes',
            'last_updated',
            'history'
          ])) ||
        (current == 'pendingPriceEntry' &&
          next == 'pendingAccountingEntry' &&
          changed.hasOnly([
            'status',
            'unit_price',
            'total_price',
            'items',
            'collector_notes',
            'last_updated',
            'history'
          ])) ||
        (current == 'pendingAccountingEntry' && role() == 'collector' &&
          next == 'pendingAccountingEntry' &&
          changed.hasOnly([
            'status',
            'unit_price',
            'total_price',
            'items',
            'collector_notes',
            'last_updated',
            'history'
          ])) ||
        (current == 'pendingAccountingEntry' && role() == 'accountant' &&
          next == 'postedToAccounting' &&
          changed.hasOnly([
            'status',
            'accounting_reference',
            'accountant_notes',
            'posted_at',
            'last_updated',
            'history'
          ])) ||
        (legacyCoreStatus(current) &&
          next == 'editPendingApprovals' &&
          changed.hasOnly([
            'previous_status',
            'status',
            'edit_request',
            'edit_approvals',
            'last_updated',
            'history'
          ])) ||
        (legacyCoreStatus(current) &&
          next == 'cancellationPendingApprovals' &&
          changed.hasOnly([
            'previous_status',
            'status',
            'cancellation_request',
            'cancellation_approvals',
            'last_updated',
            'history'
          ])) ||
        (current == 'cancellationPendingApprovals' &&
          changed.hasOnly([
            'status',
            'cancellation_approvals',
            'last_updated',
            'history'
          ])) ||
        (current == 'editPendingApprovals' &&
          changed.hasOnly([
            'status',
            'edit_approvals',
            'last_updated',
            'history'
          ]));
    }

    function legacyInvoiceUpdateAllowed() {
      return knownInterBranchUser() &&
        workflowVersion(resource.data) == 1 &&
        legacyInvoiceIdentityUnchanged() &&
        legacyInvoiceTransitionAllowed() &&
        legacyInvoiceChangedKeysAllowed() &&
        request.resource.data.get('last_updated', null) == request.time &&
        legacyHistoryAppendOnly();
    }

    function validV2PublicEvent(eventId, data) {
      return data is map &&
        data.keys().hasOnly([
          'id',
          'invoice_id',
          'workflow_version',
          'branch_ids',
          'revision',
          'action',
          'message',
          'actor_id',
          'actor_name',
          'actor_role',
          'created_at'
        ]) &&
        data.keys().hasAll([
          'id',
          'invoice_id',
          'workflow_version',
          'branch_ids',
          'revision',
          'action',
          'message',
          'actor_id',
          'actor_name',
          'actor_role',
          'created_at'
        ]) &&
        data.id == eventId &&
        data.workflow_version == 2 &&
        data.invoice_id is string && data.invoice_id.size() > 0 &&
        data.branch_ids is list && data.branch_ids.size() == 2 &&
        data.revision is int && data.revision > 0 &&
        data.action is string &&
        data.message is string &&
        data.actor_id is string &&
        data.actor_name is string &&
        data.actor_role is string &&
        data.created_at is timestamp;
    }

    function mayReadV2PublicEvent(eventId, data) {
      return knownInterBranchUser() &&
        validV2PublicEvent(eventId, data) &&
        (interBranchSupervisor() ||
          (role() == 'manager' &&
            data.branch_ids.hasAny([actorBranchId()])));
    }

    function validNotificationReadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'is_read',
          'read_at'
        ]) &&
        request.resource.data.is_read == true &&
        request.resource.data.read_at == request.time;
    }

    function validNotificationDeliveryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'device_received_at',
          'device_received_state',
          'device_platform'
        ]) &&
        request.resource.data.device_received_at == request.time &&
        request.resource.data.device_received_state in [
          'background',
          'foreground',
          'opened',
          'opened_from_terminated'
        ] &&
        request.resource.data.device_platform in [
          'android',
          'ios',
          'macos',
          'web'
        ];
    }

    function validNotificationRecipientUpdate() {
      return request.auth.uid == resource.data.get('recipient_id', '') &&
        (validNotificationReadUpdate() ||
          validNotificationDeliveryUpdate());
    }

    function legacyNotificationType(type) {
      return type == 'inter_branch_request_created' ||
        type == 'inter_branch_supplier_approved' ||
        type == 'inter_branch_supplier_rejected' ||
        type == 'inter_branch_receipt_confirmed' ||
        type == 'inter_branch_prices_entered' ||
        type == 'inter_branch_accounting_posted' ||
        type == 'inter_branch_cancellation_requested' ||
        type == 'inter_branch_edit_requested' ||
        type == 'inter_branch_cancellation_rejected' ||
        type == 'inter_branch_edit_rejected' ||
        type == 'inter_branch_cancellation_approved' ||
        type == 'inter_branch_edit_approved';
    }

    function validLegacyClientNotificationCreate(data) {
      return operationalUser() &&
        !data.get('notification_type', '').matches('^inter_branch_v2_.*') &&
        (data.get('module', '') != 'inter_branch_invoices' ||
          legacyNotificationType(data.get('notification_type', '')));
    }

    function legacyCounterOwner(branchId) {
      return knownInterBranchUser() &&
        role() == 'manager' &&
        actorBranchId() == branchId;
    }

    function validLegacyCounterCreate(branchId, data) {
      return data.keys().hasOnly([
          'branch_id',
          'branch_code',
          'next_number',
          'last_invoice_number',
          'last_updated'
        ]) &&
        data.keys().hasAll([
          'branch_id',
          'branch_code',
          'next_number',
          'last_invoice_number',
          'last_updated'
        ]) &&
        data.branch_id == branchId &&
        data.branch_code is string &&
        data.branch_code.matches('^[A-Z]{2}$') &&
        data.next_number is int && data.next_number >= 1 &&
        data.last_invoice_number is string &&
        data.last_updated == request.time;
    }

    function validLegacyCounterUpdate(branchId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'next_number',
          'last_invoice_number',
          'last_updated'
        ]) &&
        request.resource.data.get('branch_id', '') == branchId &&
        request.resource.data.get('branch_code', '') ==
          resource.data.get('branch_code', '') &&
        request.resource.data.next_number ==
          resource.data.get('next_number', 0) + 1 &&
        request.resource.data.last_invoice_number is string &&
        request.resource.data.last_updated == request.time;
    }


    match /users/{uid} {
      allow read: if operationalUser() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'notification_tokens',
          'notifications_enabled',
          'notification_platform',
          'notification_token_updated_at'
        ]);
    }

    match /password_audit_events/{eventId} {
      allow read, write: if false;
    }

    match /brands/{document=**} {
      allow read: if operationalUser();
      allow write: if adminUser();
    }

    match /branches/{document=**} {
      allow read: if operationalUser();
      allow write: if adminUser();
    }

    match /branch_codes/{document=**} {
      allow read: if operationalUser();
      allow write: if adminUser();
    }

    // Phase 1 catalog: product and group documents are deliberately price-free.
    match /product_groups/{groupId} {
      allow get, list: if mayReadCatalogDocument(resource.data);
      allow create: if accountantUser() &&
        validProductGroup(groupId, request.resource.data) &&
        request.resource.data.active == true &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.updated_by == request.auth.uid &&
        request.resource.data.created_at == request.time &&
        request.resource.data.updated_at == request.time &&
        linkedAuditMatches(
          request.resource.data.last_audit_event_id,
          'product_group',
          groupId,
          request.resource.data.brand_id,
          groupCreateAuditAction(request.resource.data)
        );
      allow update: if accountantUser() &&
        validProductGroup(groupId, request.resource.data) &&
        validProductGroupIdentityTransition() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'normalized_name',
          'legacy_code',
          'is_system_group',
          'system_key',
          'updated_by',
          'updated_by_name',
          'updated_at',
          'last_audit_event_id'
        ]) &&
        request.resource.data.last_audit_event_id !=
          resource.data.last_audit_event_id &&
        request.resource.data.updated_by == request.auth.uid &&
        request.resource.data.updated_at == request.time &&
        linkedAuditMatches(
          request.resource.data.last_audit_event_id,
          'product_group',
          groupId,
          request.resource.data.brand_id,
          'updated'
        );
      allow delete: if false;
    }

    match /products/{productId} {
      allow get, list: if mayReadCatalogDocument(resource.data);
      allow create: if accountantUser() &&
        validFallbackSystemGroupCreateAssignment(request.resource.data) &&
        validProduct(productId, request.resource.data) &&
        request.resource.data.active == true &&
        request.resource.data.version == 1 &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.updated_by == request.auth.uid &&
        request.resource.data.created_at == request.time &&
        request.resource.data.updated_at == request.time &&
        linkedAuditMatches(
          request.resource.data.last_audit_event_id,
          'product',
          productId,
          request.resource.data.brand_id,
          'created'
        );
      allow update: if accountantUser() &&
        validProductSourceProvenanceTransition() &&
        validProduct(productId, request.resource.data) &&
        validRecategorizationAuditSnapshot() &&
        validProductArchiveTransition() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'group_id',
          'name',
          'normalized_name',
          'legacy_code',
          'units',
          'primary_unit_id',
          'active',
          'version',
          'name_unique_key_id',
          'legacy_code_unique_key_id',
          'source_metadata',
          'updated_by',
          'updated_by_name',
          'updated_at',
          'last_audit_event_id',
          'archived_by',
          'archived_by_name',
          'archived_at'
        ]) &&
        request.resource.data.last_audit_event_id !=
          resource.data.last_audit_event_id &&
        request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.updated_by == request.auth.uid &&
        request.resource.data.updated_at == request.time &&
        linkedAuditMatches(
          request.resource.data.last_audit_event_id,
          'product',
          productId,
          request.resource.data.brand_id,
          productMutationAction()
        );
      allow delete: if false;
    }

    // Deterministic, permanently reserved keys make duplicate prevention safe
    // under concurrent catalog writes. Product and key writes must share a batch
    // or transaction, as checked with getAfter().
    match /product_unique_keys/{keyId} {
      allow read: if accountantUser();
      allow create: if accountantUser() &&
        validUniqueKey(keyId, request.resource.data) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.updated_by == request.auth.uid &&
        request.resource.data.created_at == request.time &&
        request.resource.data.updated_at == request.time &&
        uniqueKeyReferencesProduct(keyId, request.resource.data);
      allow update: if accountantUser() &&
        validUniqueKey(keyId, request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active',
          'updated_by',
          'updated_at'
        ]) &&
        request.resource.data.updated_by == request.auth.uid &&
        request.resource.data.updated_at == request.time &&
        uniqueKeyReferencesProduct(keyId, request.resource.data);
      allow delete: if false;
    }

    match /product_audit_events/{eventId} {
      allow read: if catalogSupervisor();
      allow create: if accountantUser() &&
        validAuditEvent(eventId, request.resource.data) &&
        auditTargetPointsBack(eventId, request.resource.data);
      allow update, delete: if false;
    }

    match /product_accounting_profiles/{profileId} {
      allow read: if accountantUser() || adminUser();
      allow create: if accountantUser() &&
        validAccountingProfile(profileId, request.resource.data) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.updated_by == request.auth.uid &&
        request.resource.data.created_at == request.time &&
        request.resource.data.updated_at == request.time &&
        linkedAuditMatches(
          request.resource.data.last_audit_event_id,
          'product_accounting_profile',
          profileId,
          request.resource.data.brand_id,
          'created'
        );
      allow update: if accountantUser() &&
        validAccountingProfile(profileId, request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accounting_reference',
          'sync_state',
          'notes',
          'updated_by',
          'updated_at',
          'last_audit_event_id'
        ]) &&
        request.resource.data.last_audit_event_id !=
          resource.data.last_audit_event_id &&
        request.resource.data.updated_by == request.auth.uid &&
        request.resource.data.updated_at == request.time &&
        linkedAuditMatches(
          request.resource.data.last_audit_event_id,
          'product_accounting_profile',
          profileId,
          request.resource.data.brand_id,
          'updated'
        );
      allow delete: if false;
    }

    // Price memory is physically separate from manager-readable catalog data.
    // Every latest-price write must atomically append its immutable history row.
    match /product_price_latest/{latestId} {
      allow get, list: if protectedPriceUser();
      // Phase 2 price writes are performed only by authenticated Admin SDK
      // commands. Admin SDK bypasses rules, so every client write is denied.
      allow create, update, delete: if false;
    }

    match /product_price_history/{historyId} {
      allow get, list: if protectedPriceUser();
      allow create, update, delete: if false;
    }

    // Existing application collections retain their current permissions in
    // Phase 1. Their schema/workflow changes belong to later approved phases.
    match /transactions/{document=**} {
      allow read, write: if operationalUser();
    }

    match /branch_transaction_counters/{document=**} {
      allow read, write: if operationalUser();
    }

    match /notifications/{notificationId} {
      allow get, list: if operationalUser() &&
        resource.data.get('recipient_id', '') == request.auth.uid;
      // Existing non-v2 notification producers remain compatible. New v2
      // inter-branch notification types are not in the legacy allow-list and
      // therefore can only be created by the Admin SDK backend.
      allow create: if validLegacyClientNotificationCreate(
        request.resource.data
      );
      allow update: if operationalUser() &&
        validNotificationRecipientUpdate();
      allow delete: if false;
    }

    match /consumable_requests/{document=**} {
      allow read, write: if operationalUser();
    }

    match /cash_expense_requests/{document=**} {
      allow read, write: if operationalUser();
    }

    match /cash_expense_request_counters/{document=**} {
      allow read, write: if operationalUser();
    }

    match /inter_branch_invoices/{invoiceId} {
      allow get: if mayReadInterBranchInvoice(invoiceId, resource.data);
      allow list: if mayListInterBranchInvoice(resource.data);
      // New invoices, all v2 transitions, and deletes are backend-only.
      allow create, delete: if false;
      // A narrowly scoped compatibility path remains for already-stored v1
      // documents. It cannot add workflow_version 2 or rewrite identity.
      allow update: if legacyInvoiceUpdateAllowed();

      match /items/{itemId} {
        allow get: if mayReadV2PublicItem(invoiceId, itemId, resource.data);
        // Manager collection queries must include an array-contains constraint
        // for their own branch so Firestore can prove every result is allowed.
        allow list: if mayListV2PublicItem(invoiceId, resource.data);
        allow create, update, delete: if false;
      }
    }

    match /inter_branch_invoice_events/{eventId} {
      allow get, list: if mayReadV2PublicEvent(eventId, resource.data);
      allow create, update, delete: if false;
    }

    match /inter_branch_invoice_prices/{invoiceId} {
      allow get, list: if protectedPriceUser();
      allow create, update, delete: if false;
    }

    match /inter_branch_invoice_price_history/{historyId} {
      allow get, list: if protectedPriceUser();
      allow create, update, delete: if false;
    }

    match /inter_branch_invoice_commands/{commandId} {
      allow read, write: if false;
    }

    match /inter_branch_invoice_counters/{branchId} {
      allow get: if legacyCounterOwner(branchId) || interBranchSupervisor();
      allow list: if false;
      allow create: if legacyCounterOwner(branchId) &&
        validLegacyCounterCreate(branchId, request.resource.data);
      allow update: if legacyCounterOwner(branchId) &&
        validLegacyCounterUpdate(branchId);
      allow delete: if false;
    }
  }
}
