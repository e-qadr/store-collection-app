FIREBASE_PROJECT_ID=store-collection-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@store-collection-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# بديل أكثر موثوقية للمتغيرات الثلاثة أعلاه:
# FIREBASE_SERVICE_ACCOUNT_BASE64=BASE64_OF_THE_COMPLETE_SERVICE_ACCOUNT_JSON
POLL_INTERVAL_MS=5000
ANDROID_NOTIFICATION_CHANNEL_ID=high_importance_channel
FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
FIREBASE_EMAIL_LOCALE=ar
# رابط اختياري يجب إضافته إلى Authorized domains في Firebase Authentication.
# PASSWORD_RESET_CONTINUE_URL=https://example.com/password-reset-complete
# نطاقات نسخة الويب فقط، مفصولة بفواصل. تطبيقات Android/iOS لا ترسل Origin.
# ALLOWED_ORIGINS=https://app.example.com
